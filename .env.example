# API keys for LLM providers. Copy this file to .env (git-ignored) and fill in
# the keys for the providers you use — you only need the ones your players.yaml
# roster references. Keys live ONLY here (in the environment), never in the YAML.

# Built-in providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Custom providers reference their own env var via providers.yaml (api_key_env),
# e.g. for the my-vllm example:
# VLLM_API_KEY=
